# ==============================================================================
# CANCIONERO - CONFIGURACIÓN DE ENTORNO Y DESPLIEGUE EN GITHUB PAGES
# ==============================================================================

# VITE_GITHUB_ALLOWED_USER:
# Usuario de GitHub autorizado como ÚNICO autor del cancionero.
# Solamente este usuario podrá identificarse y acceder al modo autor (crear/editar canciones,
# acceder a borradores e inéditas y gestionar commits Git). Cualquier otra cuenta será rechazada.
# Si no se especifica, por defecto es "tonygb".
VITE_GITHUB_ALLOWED_USER="tonygb"

# SEGURIDAD Y DESPLIEGUE EN GITHUB PAGES:
# ------------------------------------------------------------------------------
# 1. CERO SECRETOS EN EL REPOSITORIO:
#    Este repositorio es 100% público. NUNCA subas ni guardes tus tokens personales (PAT)
#    en archivos de código ni en commits de Git.
#
# 2. AUTENTICACIÓN SEGURA DIRECTA:
#    El cancionero se ejecuta 100% en el navegador (Web estática). Cuando el autor desea entrar,
#    introduce su Personal Access Token (PAT) con permiso mínimo 'read:user' directamente
#    en la ventana de acceso. La aplicación valida las credenciales en vivo contra
#    https://api.github.com/user y confirma que el login devuelto coincida exactamente con
#    VITE_GITHUB_ALLOWED_USER.
#
# 3. CONFIGURACIÓN EN GITHUB PAGES (Opcional si cambias de usuario):
#    Si deseas modificar el usuario autorizado en tu pipeline de GitHub Actions:
#    Repositorio -> Settings -> Secrets and variables -> Actions -> Variables:
#    Nombre: VITE_GITHUB_ALLOWED_USER
#    Valor: tu_usuario_de_github
#
# GEMINI_API_KEY: Requerido si se utilizan funciones de asistencia IA
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde está alojado el sitio
APP_URL="https://tonygb.com/cancionero"
